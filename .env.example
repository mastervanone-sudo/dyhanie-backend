# Скопируйте в .env и заполните
BOT_TOKEN=
WEBHOOK_SECRET=
# Токен для служебного эндпоинта /set_webhook. Если пусто — эндпоинт отключён.
SETUP_TOKEN=
# Максимальный возраст initData (секунды). Защита от replay. По умолчанию 86400.
MAX_AUTH_AGE=86400
# Строка подключения Postgres (например, Neon). Если пусто — используется SQLite (DB_PATH).
DATABASE_URL=
DB_PATH=premium.db
ALLOW_ORIGIN=https://mastervanone-sudo.github.io
REFERRAL_PERCENT=10
PORT=8080
